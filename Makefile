# Shortcuts for the docker compose commands in CLAUDE.md. Everything runs in containers except
# `make lock` (uv on the host).
.DEFAULT_GOAL := help
COMPOSE := docker compose
API := $(COMPOSE) run --rm api
API_NODB := $(COMPOSE) run --rm --no-deps api

.PHONY: help env up dev down reset-db logs test lint format migrate migration migrate-check \
	migrate-roundtrip migrate-sql migrate-supabase ui-build psql check ci eval lock

help: ## List targets
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-18s %s\n", $$1, $$2}'

env: ## Create .env from .env.example (keeps an existing one)
	@test -f .env && echo ".env already exists" || (cp .env.example .env && echo "created .env: fill LLM_API_KEY")

up: ## Prod-like: db + migrations + app on :8000
	$(COMPOSE) up --build -d --wait app
	@echo "http://localhost:8000"

dev: ## Dev: db, api with reload (:8001), vite (:5173)
	$(COMPOSE) up --build api web

down: ## Stop all containers
	$(COMPOSE) --profile dev down

reset-db: ## Stop everything and wipe the local Postgres volume
	$(COMPOSE) --profile dev down -v

logs: ## Follow logs (make logs s=app)
	$(COMPOSE) logs -f $(s)

test: ## Backend tests
	$(API_NODB) pytest -q

lint: ## Ruff lint + format check
	$(API_NODB) sh -c "ruff check . && ruff format --check ."

format: ## Ruff autofix + format
	$(API_NODB) sh -c "ruff check --fix . && ruff format ."

migrate: ## Apply migrations (alembic upgrade head)
	$(API) alembic upgrade head

migration: ## New autogenerated revision: make migration m="add x" (then READ the file)
	@test -n "$(m)" || (echo 'usage: make migration m="add x"' && exit 1)
	$(API) alembic revision --autogenerate -m "$(m)"

migrate-check: ## Fail if models changed without a migration
	$(API) alembic check

migrate-roundtrip: ## Downgrade to base and upgrade again (local db only)
	$(API) sh -c "alembic downgrade base && alembic upgrade head"

migrate-sql: ## Print the migration SQL without a DB
	$(API_NODB) alembic upgrade head --sql

migrate-supabase: ## Apply migrations to Supabase (SUPABASE_DB_URL in .env: session pooler, port 5432)
	$(API_NODB) sh -c 'test -n "$$SUPABASE_DB_URL" || { echo "set SUPABASE_DB_URL in .env"; exit 1; }; \
		DATABASE_URL="$$SUPABASE_DB_URL" alembic upgrade head'

eval: ## Evaluate the real agent on the dataset (LLM calls!): make eval args="--category guardrail"
	$(API_NODB) python -m app.evals $(args)

ui-build: ## Build the React app (frontend/dist)
	$(COMPOSE) run --rm --no-deps web sh -c "npm install && npm run build"

psql: ## SQL shell on the local db
	$(COMPOSE) up -d --wait db
	$(COMPOSE) exec db sh -c 'psql -U "$$POSTGRES_USER" -d "$$POSTGRES_DB"'

check: lint test migrate-check ui-build ## Everything /check runs before a commit

ci: lint test migrate migrate-check migrate-roundtrip ui-build ## What GitHub Actions runs (fresh db: migrate first)

lock: ## Re-lock uv deps on the host (after editing pyproject); images rebuild on next up/dev
	cd backend && uv lock
