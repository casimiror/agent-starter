# LLM (provider: openrouter | anthropic | openai). OpenRouter model ids are "<vendor>/<model>".
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-3.5-flash-lite
LLM_API_KEY=
# optional: defaults to https://openrouter.ai/api/v1 for openrouter
LLM_BASE_URL=
# Resilience: each model retries timeouts, 429 and 5xx (LLM_MAX_RETRIES, with backoff), then the
# agent tries LLM_FALLBACKS in order ("provider:model", JSON list). A fallback on another provider
# uses that provider's key below. Worst case per LLM call: LLM_TIMEOUT x (LLM_MAX_RETRIES + 1) per
# model tried; a turn with tools makes several calls. Keep it under Vercel's maxDuration (60 s,
# backend/vercel.json).
LLM_TIMEOUT=25
LLM_MAX_RETRIES=1
LLM_FALLBACKS=[]
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Postgres, backend only (never ship to the browser). Default: the local `db` service from
# docker compose (Postgres 17, local-only credentials fixed in docker-compose.yml).
DATABASE_URL=postgresql+psycopg://app:app_local_pw@db:5432/app
# Supabase (deploy). Copy both from Supabase > Connect; any postgres:// form works (app/db/url.py).
# - Vercel env DATABASE_URL (or the integration's POSTGRES_URL): transaction pooler, port 6543.
# - SUPABASE_DB_URL here, for `make migrate-supabase`: session pooler, port 5432 (IPv4; the
#   direct db.<ref>.supabase.co host is IPv6-only and unreachable from Docker on most Macs).
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Host port of the local db, for a DB GUI on localhost. Unset: a random free port (`make db-port`).
# POSTGRES_PORT=54320

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Trace environment; defaults to Vercel's VERCEL_ENV, else development.
# LANGFUSE_TRACING_ENVIRONMENT=development

# Evaluation (local only: `make eval`, /eval page). Never enable on Vercel.
EVAL_ENABLED=false
EVAL_JUDGE_MODEL=google/gemini-3.8-flash

# Limits
RATE_LIMIT_CHAT=10/minute
# memory:// counts per process (per instance on Vercel); a Redis URL (Upstash: rediss://...) is global.
RATE_LIMIT_STORAGE_URI=memory://
MAX_INPUT_CHARS=2000
MAX_HISTORY_MESSAGES=20

# App
APP_NAME=assistant
# URL prefixes the agent may write; any other URL in a reply is replaced (JSON list).
ALLOWED_LINKS=[]

# Logs (stdout). json in production (Vercel collects it); text reads better in a local terminal.
LOG_LEVEL=INFO
LOG_FORMAT=text

# Channels beyond the web UI (docs/channels.md). Comma-separated: web, whatsapp, voice. `web`
# (/api/chat) is always on. Any other channel needs CHANNEL_ID_SECRET and PUBLIC_BASE_URL or the
# app refuses to start.
CHANNELS=web
# Keys the hash that turns a sender (phone number) into an anonymous visitor id; generate with
# `openssl rand -hex 32`. Rotating it splits every sender's history.
CHANNEL_ID_SECRET=
# Public https origin of this app, used to build webhook URLs. Locally: https://<NGROK_DOMAIN>.
PUBLIC_BASE_URL=
# A sender's conversation is reused while their last message is newer than this.
CONVERSATION_WINDOW_HOURS=24
